# Copy to backend/.env and fill in your token. backend/.env is gitignored.

# Databricks workspace base URL (no trailing slash)
DATABRICKS_HOST=https://adb-3011697725699826.6.azuredatabricks.net

# Optional: override DATABRICKS_HOST (used in Databricks App app.yaml as DATABRICKS_HOST_OVERRIDE)
# DATABRICKS_HOST_OVERRIDE=
# Required with host override when not using a PAT — OAuth for the target workspace:
# DATABRICKS_CLIENT_ID_OVERRIDE=
# DATABRICKS_CLIENT_SECRET_OVERRIDE=

# Personal access token (Bearer). REQUIRED.
DATABRICKS_TOKEN=

# SQL warehouse for the Statement Execution API (today's schedule)
WAREHOUSE_ID=17f6d9fabd1c7633

# Model serving endpoint name for the agent
SERVING_ENDPOINT=mas-e8cd6cde-endpoint

# Allowed CORS origins for the frontend dev server (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
